{
  "name": "jianming-zhongwen",
  "displayName": "简明技术中文",
  "description": "用简明技术中文写作：短句、实义动词、条件在前、情态词按阶梯、一词一义、术语首次出现时定义。回复最多 5 句，只用散文。",
  "version": "1.0.2",
  "author": {
    "name": "heichaowo"
  },
  "homepage": "https://github.com/heichaowo/jianming-zhongwen",
  "repository": "https://github.com/heichaowo/jianming-zhongwen",
  "license": "MIT",
  "keywords": [
    "technical-writing",
    "documentation",
    "chinese",
    "plain-language"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/hooks/activate.js\"",
            "timeout": 5,
            "statusMessage": "加载简明技术中文规则..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/src/hooks/lint_hook.py\"",
            "timeout": 10,
            "statusMessage": "简明技术中文：检查文件..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/src/hooks/lint_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
